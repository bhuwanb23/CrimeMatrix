# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=gemini

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=CrimeMatrix
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database provider: sqlite | catalyst_local | catalyst
DB_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///data/crimematrix.db

# Catalyst Data Store (IN) — required when DB_PROVIDER=catalyst
CATALYST_PROJECT_ID=46575000000013023
CATALYST_ORG_ID=60079208195
CATALYST_ENVIRONMENT=Development
CATALYST_API_DOMAIN=https://api.catalyst.zoho.in
CATALYST_ACCOUNTS_DOMAIN=https://accounts.zoho.in
CATALYST_CLIENT_ID=
CATALYST_CLIENT_SECRET=
CATALYST_REFRESH_TOKEN=
# CATALYST_ACCESS_TOKEN=
CATALYST_FILE_FOLDER=cm_uploads
