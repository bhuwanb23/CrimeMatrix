# AI Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_AI_PROVIDER=gemini

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=CrimeMatrix
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database provider: sqlite | catalyst_local | catalyst
DB_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///data/crimematrix.db

# Cross-service (local defaults)
AI_SERVICES_URL=http://localhost:8002
BACKEND_URL=http://localhost:8000

# --- Catalyst Data Store credentials ---
# AppSail console REJECTS keys named CATALYST_* (platform-reserved).
# Prefer CM_* everywhere; CATALYST_* still works locally as a fallback.
CM_PROJECT_ID=46575000000013023
CM_ORG_ID=60079208195
CM_ENVIRONMENT=Development
CM_API_DOMAIN=https://api.catalyst.zoho.in
CM_ACCOUNTS_DOMAIN=https://accounts.zoho.in
CM_CLIENT_ID=
CM_CLIENT_SECRET=
CM_REFRESH_TOKEN=
# CM_ACCESS_TOKEN=
CM_FILE_FOLDER=cm_uploads
# CM_FILE_FOLDER_ID=
# STORAGE_PROVIDER=catalyst

